{
  "schemaVersion": 1,
  "packageVersion": "1.0.7",
  "minimumServiceCapability": "enterprise-workflows-v1",
  "minimumLauncherVersion": "0.17.0",
  "launcherInstallationOwner": "smedc-mcp",
  "hosts": {
    "codex": {
      "platform": "macos",
      "schedule": "standalone-local-cron",
      "timezone": "Asia/Shanghai",
      "browser": "iab",
      "browserFallback": ["chrome"]
    },
    "dsh": {
      "platform": "macos",
      "schedule": "native-session-recurrence",
      "timezone": "Asia/Shanghai",
      "browser": "browser-skill",
      "minimumLauncherVersion": "0.20.1"
    }
  },
  "mailAdapters": ["gmail", "smtp"],
  "configurationSchemaVersion": 1,
  "inputs": [
    "authenticated enterprise selector",
    "immutable run snapshot",
    "current control and assignment"
  ],
  "outputs": ["central minimal receipts", "local evidence", "final report"],
  "workflows": {
    "meituan-daily-ingestion": {
      "dependencies": [
        "download-meituan-business-data",
        "download-meituan-dish-sales",
        "meituan-order-details-download",
        "meituan-takeout-order-details-download",
        "download-meituan-delivery-ledger",
        "smedc-delivery-ledger"
      ],
      "dependencyCompatibility": {
        "strategy": "same-immutable-source-revision-and-complete-subtree-hash",
        "workflowPackageVersion": "1.0.7"
      },
      "window": "previous-complete-business-day",
      "capabilities": [
        "configuration",
        "permissions",
        "meituan_erp",
        "download",
        "workspace",
        "dependencies",
        "host_schedule",
        "host_timezone",
        "host_model",
        "assignment",
        "file_format"
      ],
      "authorizations": ["download", "upload"],
      "orderScope": "settled_only",
      "stages": [
        "collect",
        "validate_original",
        "upload",
        "verify_published",
        "cleanup_confirmed_files"
      ]
    },
    "meituan-review-operations": {
      "dependencies": ["reply-meituan-reviews", "review-responder"],
      "dependencyCompatibility": {
        "strategy": "same-immutable-source-revision-and-complete-subtree-hash",
        "workflowPackageVersion": "1.0.7"
      },
      "window": "previous-day-and-today",
      "capabilities": [
        "configuration",
        "permissions",
        "meituan_reviews",
        "workspace",
        "dependencies",
        "host_schedule",
        "host_timezone",
        "host_model",
        "assignment",
        "file_format"
      ],
      "optionalCapabilities": [
        "download",
        "email_identity",
        "sent_mail_lookup"
      ],
      "authorizations": [
        "review_sync",
        "review_publish",
        "email:review_drafts"
      ],
      "publicationDefault": false,
      "stages": [
        "collect",
        "verify_identity",
        "draft",
        "workbook",
        "notify_new_drafts",
        "publish_authorized",
        "sync_and_readback",
        "archive_complete_run",
        "cleanup_complete_run"
      ]
    },
    "weekly-business-report": {
      "dependencies": ["smedc-business-analysis"],
      "dependencyCompatibility": {
        "strategy": "same-immutable-source-revision-and-complete-subtree-hash",
        "workflowPackageVersion": "1.0.7"
      },
      "window": "previous-natural-week",
      "capabilities": [
        "configuration",
        "permissions",
        "download",
        "workspace",
        "dependencies",
        "host_schedule",
        "host_timezone",
        "host_model",
        "assignment"
      ],
      "optionalCapabilities": ["email_identity", "sent_mail_lookup"],
      "authorizations": ["download", "email:weekly_report"],
      "stages": [
        "query_coverage",
        "download_authorized",
        "aggregate_exact_stores",
        "report_and_advisory",
        "verify_final",
        "deliver_optional",
        "retain_final_report"
      ]
    }
  },
  "executionPolicies": [
    {
      "id": "verified-review-operations",
      "version": 1
    }
  ],
  "capabilityVersion": "1.0.0",
  "runtimeRequirements": {
    "python": ">=3.11",
    "node": ">=22",
    "reviewPythonPackages": ["openpyxl>=3.1.5,<4"],
    "reviewNodePackages": ["@oai/artifact-tool"],
    "discovery": "invoking host load_workspace_dependencies"
  },
  "scheduleSelection": "explicit-user-confirmation-or-verified-host-migration"
}
