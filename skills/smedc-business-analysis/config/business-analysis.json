{
  "schemaVersion": 1,
  "datasets": {
    "business": {
      "dataset": "business",
      "metadataPolicy": "window",
      "requiredFor": ["coreBusiness", "weeklyTrend", "monthlyTrend", "channelMix", "daypartAttribution", "stallSalesMix", "productSalesPer10k"]
    },
    "dishes": {
      "dataset": "dishes",
      "metadataPolicy": "window",
      "requiredFor": ["stallAttribution", "stallSalesMix", "productSalesPer10k"]
    },
    "dish_catalog": {
      "dataset": "dish_catalog",
      "metadataPolicy": "snapshot",
      "requiredFor": ["stallAttribution", "stallSalesMix", "productSalesPer10k"]
    }
  },
  "fields": {
    "business": {
      "date": "business_date",
      "week": "business_week",
      "month": "business_month",
      "store": "store_name",
      "city": "city",
      "merchant": "merchant_id",
      "orderCategory": "order_category",
      "orderSource": "order_source",
      "mealPeriod": "meal_period",
      "timeSlot": "time_slot",
      "membership": "is_member",
      "diningMethod": "dining_method",
      "grossSales": "gross_sales_amount",
      "orderRevenue": "order_revenue",
      "discount": "discount_amount",
      "validOrders": "valid_order_count",
      "positiveOrders": "positive_order_count",
      "reverseOrders": "reverse_order_count",
      "settledOrders": "settled_order_count",
      "dinerCount": "diner_count",
      "consumedTables": "served_table_count",
      "tableCount": "table_count",
      "tableUses": "table_use_count",
      "tableDayCount": "table_days",
      "businessDayCount": "business_day_count",
      "dineInGrossSales": "dine_in_sales_amount",
      "dineInRevenue": "dine_in_revenue",
      "dineInDiscount": "dine_in_discount_amount",
      "dineInOrders": "dine_in_order_count",
      "dineInPositiveOrders": "dine_in_positive_order_count",
      "dineInRefundAmount": "dine_in_refund_amount",
      "deliveryGrossSales": "delivery_sales_amount",
      "deliveryRevenue": "delivery_revenue",
      "deliveryDiscount": "delivery_discount_amount",
      "deliveryOrders": "delivery_order_count",
      "deliveryPositiveOrders": "delivery_positive_order_count",
      "deliveryRefundAmount": "delivery_refund_amount",
      "meituanDeliveryGrossSales": "meituan_delivery_sales_amount",
      "meituanDeliveryRevenue": "meituan_delivery_revenue",
      "meituanDeliveryRefundAmount": "meituan_delivery_refund_amount",
      "elemeDeliveryGrossSales": "eleme_delivery_sales_amount",
      "elemeDeliveryRevenue": "eleme_delivery_revenue",
      "elemeDeliveryRefundAmount": "eleme_delivery_refund_amount",
      "jdDeliveryGrossSales": "jd_delivery_sales_amount",
      "jdDeliveryRevenue": "jd_delivery_revenue",
      "jdDeliveryRefundAmount": "jd_delivery_refund_amount",
      "pickupGrossSales": "pickup_sales_amount",
      "pickupRevenue": "pickup_revenue",
      "pickupDiscount": "pickup_discount_amount",
      "pickupOrders": "pickup_order_count",
      "pickupPositiveOrders": "pickup_positive_order_count",
      "pickupRefundAmount": "pickup_refund_amount",
      "memberGrossSales": "member_consumption_amount",
      "memberRevenue": "member_order_revenue",
      "discountRate": "discount_rate",
      "openRate": "open_rate",
      "turnoverRate": "table_turnover_rate"
    },
    "dishes": {
      "date": "business_date",
      "week": "business_week",
      "month": "business_month",
      "store": "store_name",
      "city": "city",
      "merchant": "merchant_id",
      "orderTime": "order_time",
      "orderCategory": "order_category",
      "timeSlot": "time_slot",
      "productName": "product_name",
      "matchedProductName": "matched_product_name",
      "organizationCode": "organization_code",
      "quantity": "dish_sales_quantity",
      "sales": "dish_sales_amount",
      "revenue": "dish_revenue",
      "discount": "dish_discount_amount",
      "totalSales": "dish_total_sales_amount",
      "totalRevenue": "dish_total_revenue",
      "totalDiscount": "dish_total_discount_amount",
      "positiveOrders": "dish_positive_order_count",
      "returnedQuantity": "returned_dish_quantity",
      "returnedAmount": "returned_dish_amount",
      "servingOrders": "serving_order_count",
      "afterDiscountGrossMargin": "dish_total_gross_margin_after_discount"
    },
    "dish_catalog": {
      "snapshotDate": "snapshot_date",
      "dishName": "dish_name",
      "baseCategory": "base_category_name",
      "stall": "base_category_name",
      "spuId": "spu_id",
      "skuId": "sku_id",
      "alias": "dish_alias",
      "price": "sale_price"
    }
  },
  "dimensions": {
    "store": ["business.store", "dishes.store"],
    "period": ["business.date", "business.week", "business.month", "dishes.date", "dishes.week", "dishes.month"],
    "channel": ["business.orderCategory", "business.orderSource", "business.diningMethod", "dishes.orderCategory"],
    "daypart": ["business.mealPeriod", "business.timeSlot", "dishes.timeSlot"],
    "dish": ["dishes.productName", "dishes.matchedProductName"],
    "catalog": ["dish_catalog.dishName", "dish_catalog.baseCategory", "dish_catalog.stall"]
  },
  "measures": {
    "businessRevenue": {
      "field": "business.orderRevenue",
      "aggregate": "sum",
      "displayName": "订单营业收入"
    },
    "grossSales": {
      "field": "business.grossSales",
      "aggregate": "sum",
      "displayName": "营业额"
    },
    "discount": {
      "field": "business.discount",
      "aggregate": "sum",
      "displayName": "优惠金额"
    },
    "orders": {
      "field": "business.positiveOrders",
      "aggregate": "sum",
      "displayName": "正向订单量"
    },
    "diners": {
      "field": "business.dinerCount",
      "aggregate": "sum",
      "displayName": "用餐人数"
    },
    "openRate": {
      "field": "business.openRate",
      "weightField": "business.tableDayCount",
      "aggregate": "weightedAvg",
      "displayName": "开台率"
    },
    "turnoverRate": {
      "field": "business.turnoverRate",
      "weightField": "business.tableDayCount",
      "aggregate": "weightedAvg",
      "displayName": "翻台率"
    },
    "dishQuantity": {
      "field": "dishes.quantity",
      "aggregate": "sum",
      "displayName": "菜品销售数量"
    },
    "dishRevenue": {
      "field": "dishes.revenue",
      "aggregate": "sum",
      "displayName": "菜品收入"
    }
  },
  "reportModules": {
    "coreBusiness": {
      "requiredDatasets": ["business"],
      "partialPolicy": "renderWithCurrentPeriodBusinessData"
    },
    "weeklyTrend": {
      "requiredDatasets": ["business"],
      "bucketCount": 52,
      "partialPolicy": "renderAvailableCompleteWeeks"
    },
    "monthlyTrend": {
      "requiredDatasets": ["business"],
      "bucketCount": 12,
      "partialPolicy": "renderAvailableCompleteMonths"
    },
    "channelMix": {
      "requiredDatasets": ["business"],
      "partialPolicy": "renderWhenBusinessRowsCoverRequestedPeriod"
    },
    "daypartAttribution": {
      "requiredDatasets": ["business"],
      "partialPolicy": "renderAvailableComparisons"
    },
    "stallAttribution": {
      "requiredDatasets": ["dishes", "dish_catalog"],
      "partialPolicy": "disableWhenEitherInputMissing"
    },
    "stallSalesMix": {
      "requiredDatasets": ["business", "dishes", "dish_catalog"],
      "partialPolicy": "disableWhenDishOrCatalogMissing"
    },
    "productSalesPer10k": {
      "requiredDatasets": ["business", "dishes", "dish_catalog"],
      "panels": ["orderRevenue", "grossSales"],
      "partialPolicy": "disableWhenDishOrCatalogMissing"
    }
  },
  "queryLimits": {
    "maxGroupByFields": 4,
    "maxAggregates": 12,
    "maxAggregateGroups": 200,
    "maxRows": 200,
    "maxSortFields": 2,
    "maxConditions": 20,
    "maxInValues": 100,
    "cursorTtlSeconds": 900
  }
}
